[Unit]
Description=NovelWiki OpenAI Codex App Server worker
After=network-online.target

[Service]
WorkingDirectory=%h/wiki
ExecStart=%h/wiki/.venv/bin/python -m novelwiki.openai_codex.worker
Restart=on-failure
RestartSec=10
Environment=HOST_WORKER_DATABASE_HOST=127.0.0.1

MemoryMax=4G
TasksMax=256
CPUWeight=50
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=default.target
