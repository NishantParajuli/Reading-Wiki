{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NovelWiki codex extraction",
  "type": "object",
  "required": ["schema_version", "chapter", "source_sha256", "mentions", "facts", "relationships", "events", "identity_reveals", "new_aliases", "state_changes", "relationship_state_changes", "thread_updates", "memory_updates", "warnings"],
  "properties": {
    "schema_version": {"const": "2.2"},
    "chapter": {"type": "number", "description": "Copy input/manifest.json chapter_ceiling exactly."},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$", "description": "Copy input/schema.json source_sha256 exactly; this is not the chapter.md artifact hash."},
    "mentions": {"type": "array"},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/groundedItem"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/groundedItem"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/groundedItem"}},
    "identity_reveals": {"type": "array", "items": {"$ref": "#/$defs/groundedItem"}},
    "new_aliases": {"type": "array", "items": {"$ref": "#/$defs/groundedItem"}},
    "state_changes": {"type": "array", "items": {"$ref": "#/$defs/groundedItem"}},
    "relationship_state_changes": {"type": "array", "items": {"$ref": "#/$defs/groundedItem"}},
    "thread_updates": {"type": "array", "items": {"$ref": "#/$defs/groundedItem"}},
    "memory_updates": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["kind", "summary", "covered_chapters", "key_beats", "evidence_chunk_ids"],
        "properties": {
          "kind": {"enum": ["checkpoint", "volume"]},
          "summary": {"type": ["string", "null"]},
          "covered_chapters": {"type": "array", "minItems": 1, "items": {"type": "number"}},
          "key_beats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["chapter_refs", "summary"],
              "properties": {
                "chapter_refs": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "number"}},
                "summary": {"type": "string", "minLength": 40}
              },
              "additionalProperties": false
            }
          },
          "evidence_chunk_ids": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}
        },
        "additionalProperties": false
      }
    },
    "warnings": {"type": "array"}
  },
  "$defs": {
    "groundedItem": {
      "type": "object",
      "required": ["evidence_text", "source_chunk_ids"],
      "properties": {
        "evidence_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "A short verbatim span copied from one cited current-chapter chunk."
        },
        "source_chunk_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {"type": "integer", "minimum": 1}
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
