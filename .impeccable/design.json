      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The principal action uses the chosen accent without a shadow.",
      "html": "<button type=\"button\" class=\"ds-btn\">Continue reading</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:10px 18px;border:1px solid transparent;border-radius:var(--radius-sm,6px);font:600 .9375rem var(--sans,\"Hanken Grotesk\",sans-serif);cursor:pointer;transition:background 120ms ease,color 120ms ease,filter 120ms ease}.ds-btn:focus-visible{outline:2px solid var(--accent,oklch(.40 .065 165));outline-offset:3px}.ds-btn:disabled{opacity:.55;cursor:not-allowed}.ds-btn{background:var(--accent,oklch(.40 .065 165));color:var(--on-accent,oklch(.99 .01 90))}.ds-btn:hover:not(:disabled){filter:brightness(1.05)}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
