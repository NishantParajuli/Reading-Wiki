      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:10px 18px;border:1px solid transparent;border-radius:var(--radius-sm,6px);font:600 .9375rem var(--sans,\"Hanken Grotesk\",sans-serif);cursor:pointer;transition:background 120ms ease,color 120ms ease,filter 120ms ease}.ds-btn:focus-visible{outline:2px solid var(--accent,oklch(.40 .065 165));outline-offset:3px}.ds-btn:disabled{opacity:.55;cursor:not-allowed}.ds-btn{background:var(--surface,oklch(.995 .006 86));color:var(--ink,oklch(.27 .015 155));border-color:var(--border,oklch(.9 .015 80))}.ds-btn:hover:not(:disabled){background:var(--surface-2,oklch(.978 .009 84));border-color:var(--border-2,oklch(.85 .018 78))}"
